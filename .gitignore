# Model artifacts — can leak training data, never commit
*.joblib
*.pkl

# Dashboard auth — never commit credentials
dashboard_users.json

# Synthetic data & generated artifacts — regenerable, and the encrypted identity blob must
# NEVER be committed (especially alongside the dev encryption key in secure_data.py)
data/
*.parquet

# Generated reports (franchise PDF is produced on demand)
reports_franchise_revenue.pdf
franchise_revenue_report.pdf
*.pdf

# Python environments and cache
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.agent/
.agents/

